
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Space Information</title>

<style>
body {
    background: #050817;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
    margin: 0;
    padding: 20px;
}

h1 {
    color: #55c8ff;
    text-shadow: 0 0 15px #008cff;
}

.planet {
    background: #111b35;
    border: 1px solid #263d68;
    border-radius: 15px;
    padding: 18px;
    margin: 15px auto;
    max-width: 400px;
    box-shadow: 0 0 12px #102b55;
}

.planet h2 {
    color: #7bd5ff;
}

.planet p {
    color: #d5e5ff;
    font-size: 16px;
}

button {
    background: #087bc5;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 15px;
}
</style>
